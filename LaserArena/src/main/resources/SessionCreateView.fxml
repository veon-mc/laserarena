<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.laserarena.Controller.SessionCreateController">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 14 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-background-color: white;">
                <Label text="LaserArena" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Sessions" styleClass="nav-btn" onAction="#onNavSessions"/>
                <Button text="Billets"  styleClass="nav-btn" onAction="#onNavBillets"/>
                <Button text="Scanner"  styleClass="nav-btn" onAction="#onNavScanner"/>
            </HBox>
            <HBox style="-fx-padding: 16 28 16 28; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <Label text="Nouvelle session" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-border-width: 0; -fx-background-color: transparent;">
            <VBox spacing="18" style="-fx-padding: 24 28;">

                <!-- Nom -->
                <VBox spacing="6">
                    <Label text="Nom de la session" styleClass="form-label"/>
                    <TextField fx:id="nomField" promptText="Ex : Session du soir"/>
                </VBox>

                <!-- Type de partie -->
                <VBox spacing="6">
                    <Label text="Type de partie" styleClass="form-label"/>
                    <ComboBox fx:id="typePartieCombo" maxWidth="Infinity" onAction="#onTypePartieChange"/>
                </VBox>

                <!-- Durée : panel de boutons -->
                <VBox spacing="8">
                    <Label text="Durée de la partie" styleClass="form-label"/>
                    <HBox spacing="10" fx:id="dureeBox">
                        <ToggleButton fx:id="btn15"  text="15 min" onAction="#onDureeSelect" prefWidth="90"/>
                        <ToggleButton fx:id="btn30"  text="30 min" onAction="#onDureeSelect" prefWidth="90"/>
                        <ToggleButton fx:id="btn45"  text="45 min" onAction="#onDureeSelect" prefWidth="90"/>
                        <ToggleButton fx:id="btn60"  text="1 heure" onAction="#onDureeSelect" prefWidth="90"/>
                    </HBox>
                </VBox>

                <!-- Nombre de joueurs (pour ELIMINATION) -->
                <VBox fx:id="panelJoueursSimple" spacing="6">
                    <Label text="Nombre maximum de joueurs" styleClass="form-label"/>
                    <TextField fx:id="maxJoueursField" promptText="10"/>
                </VBox>

                <!-- Panel équipes (pour EQUIPES et CAPTURE_DRAPEAU) -->
                <VBox fx:id="panelEquipes" spacing="12" managed="false" visible="false">
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Nombre d'équipes" styleClass="form-label"/>
                            <Spinner fx:id="spinnerEquipes" min="2" max="10" initialValue="2" editable="true" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Joueurs par équipe" styleClass="form-label"/>
                            <Spinner fx:id="spinnerJoueursParEquipe" min="1" max="20" initialValue="4" editable="true" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="8">
                        <Label text="Noms des équipes" styleClass="form-label"/>
                        <VBox fx:id="nomsEquipesBox" spacing="6"/>
                    </VBox>
                    <Label fx:id="infoJoueursLabel" text="" style="-fx-text-fill: #555; -fx-font-size: 12px;"/>
                </VBox>

                <!-- Date expiration -->
                <VBox spacing="6">
                    <Label text="Date d'expiration des billets" styleClass="form-label"/>
                    <DatePicker fx:id="dateExpirationPicker" maxWidth="Infinity"/>
                </VBox>

                <Label fx:id="errorLabel" text="" style="-fx-text-fill: #c0392b; -fx-font-size: 13px;"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10"
              style="-fx-padding: 16 28; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0; -fx-background-color: white;">
            <Button text="Annuler"          styleClass="btn-cancel"  onAction="#onAnnuler"/>
            <Button text="Créer la session" styleClass="btn-primary" onAction="#onCreer"/>
        </HBox>
    </bottom>

</BorderPane>
