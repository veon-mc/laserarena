<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controller.BilletListController">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 14 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-background-color: white;">
                <Label text="LaserArena" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Sessions" styleClass="nav-btn"        onAction="#onNavSessions"/>
                <Button text="Billets"  styleClass="nav-btn-active" onAction="#onNavBillets"/>
                <Button text="Scanner"  styleClass="nav-btn"        onAction="#onNavScanner"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 10 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <Label text="Session :" style="-fx-text-fill: #888; -fx-font-size: 13px;"/>
                <Label fx:id="sessionNomLabel" text="" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Label fx:id="billetCountLabel" text="0 billets" style="-fx-text-fill: #888; -fx-font-size: 13px; -fx-padding: 0 0 0 12;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ GÃŠnÃŠrer un billet" styleClass="btn-primary" onAction="#onGenererBillet"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="billetTable" style="-fx-border-width: 0;">
            <columns>
                <TableColumn fx:id="colCode"       text="Code"       prefWidth="200"/>
                <TableColumn fx:id="colStatut"     text="Statut"     prefWidth="120"/>
                <TableColumn fx:id="colExpiration" text="Expiration" prefWidth="140"/>
                <TableColumn fx:id="colQr"         text="QR code"    prefWidth="140"/>
            </columns>
        </TableView>
    </center>

</BorderPane>